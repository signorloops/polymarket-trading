{
  "name": "polymarket-trading",
  "version": "1.0.0",
  "description": "Polymarket arbitrage trading system with marginal polytope and Frank-Wolfe optimization",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "typecheck": "tsc --noEmit",
    "benchmark": "npm run build && node dist/benchmarks/math.bench.js",
    "benchmark:math": "npm run build && node dist/benchmarks/math.bench.js",
    "benchmark:fw": "npm run build && node dist/benchmarks/frank-wolfe.bench.js",
    "benchmark:orderbook": "npm run build && node dist/benchmarks/orderbook.bench.js",
    "prepare": "husky install"
  },
  "keywords": [
    "polymarket",
    "arbitrage",
    "trading",
    "frank-wolfe",
    "prediction-markets"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^8.0.0",
    "jest": "^30.2.0",
    "lint-staged": "^16.3.1",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "dependencies": {
    "@slack/webhook": "^7.0.7",
    "axios": "^1.13.4",
    "dotenv": "^17.3.1",
    "javascript-lp-solver": "^1.0.3",
    "nodemailer": "^8.0.1",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  }
}
