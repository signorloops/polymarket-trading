{
  "name": "polymarket-trading",
  "version": "1.0.0",
  "description": "Polymarket arbitrage trading system with marginal polytope and Frank-Wolfe optimization",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/src",
    "dist/benchmarks",
    "README.md",
    "README.en.md",
    "README.zh-CN.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/src/index.js",
    "dev": "tsc --watch",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "typecheck": "tsc --noEmit",
    "benchmark": "npm run build && node dist/benchmarks/math.bench.js",
    "benchmark:math": "npm run build && node dist/benchmarks/math.bench.js",
    "benchmark:fw": "npm run build && node dist/benchmarks/frank-wolfe.bench.js",
    "benchmark:orderbook": "npm run build && node dist/benchmarks/orderbook.bench.js",
    "runtime-config:generate": "npm run build && node dist/src/scripts/runtime-config.js generate",
    "runtime-config:validate": "npm run build && node dist/src/scripts/runtime-config.js validate",
    "smoke:daemon": "npm run build && npm run smoke:daemon:built",
    "smoke:daemon:built": "node dist/src/scripts/daemon-smoke.js",
    "smoke:docker": "npm run build && npm run smoke:docker:built",
    "smoke:docker:built": "node dist/src/scripts/docker-smoke.js",
    "canary:trade": "npm run build && node dist/src/scripts/canary-trade.js",
    "canary:cancel-all": "npm run build && node dist/src/scripts/canary-cancel-all.js",
    "canary:kill-switch": "npm run build && node dist/src/scripts/canary-kill-switch.js",
    "reconcile:balances": "npm run build && node dist/src/scripts/reconcile-balances.js",
    "user-stream:check": "npm run build && node dist/src/scripts/user-stream-check.js",
    "audit:operator-readiness": "npm run build && node dist/src/scripts/operator-readiness-audit.js",
    "prepare": "husky install",
    "prepack": "npm run build"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "polymarket",
    "arbitrage",
    "trading",
    "frank-wolfe",
    "prediction-markets"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.5",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^8.0.0",
    "jest": "^30.2.0",
    "knip": "^6.27.0",
    "lint-staged": "^16.3.2",
    "pg-mem": "^3.0.14",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "1.0.8",
    "@slack/webhook": "^7.0.7",
    "axios": "^1.18.1",
    "dotenv": "^17.3.1",
    "javascript-lp-solver": "^1.0.3",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "viem": "^2.55.2",
    "ws": "8.21.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "ws": "8.21.1"
  }
}
