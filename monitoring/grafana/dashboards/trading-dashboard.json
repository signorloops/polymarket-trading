{
  "id": null,
  "uid": "polymarket-trading",
  "title": "Polymarket Trading System",
  "tags": ["trading", "polymarket"],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Arbitrage Opportunities Found",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(trading_arbitrage_opportunities_total)",
          "legendFormat": "Total Found"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "Arbitrage Executed",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(trading_arbitrage_executed_total)",
          "legendFormat": "Total Executed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "Total Profit",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(trading_arbitrage_profit_total)",
          "legendFormat": "Profit (USD)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 4,
      "title": "Success Rate",
      "type": "gauge",
      "targets": [
        {
          "expr": "100 * sum(rate(trading_arbitrage_executed_total[5m])) / clamp_min(sum(rate(trading_arbitrage_opportunities_total[5m])), 0.000001)",
          "legendFormat": "Success Rate %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "green",
                "value": 80
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "id": 5,
      "title": "Frank-Wolfe Iterations",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(trading_frank_wolfe_iterations_sum[5m])) / clamp_min(sum(rate(trading_frank_wolfe_iterations_count[5m])), 0.000001)",
          "legendFormat": "Iterations"
        }
      ],
      "xAxis": {
        "mode": "time"
      },
      "yAxes": [
        {
          "label": "Iterations",
          "min": 0
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 6,
      "title": "Frank-Wolfe Gap",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(trading_frank_wolfe_gap_bucket[5m])))",
          "legendFormat": "Gap"
        }
      ],
      "xAxis": {
        "mode": "time"
      },
      "yAxes": [
        {
          "label": "Gap",
          "min": 0
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "id": 7,
      "title": "Orders Submitted",
      "type": "graph",
      "targets": [
        {
          "expr": "60 * sum(rate(trading_orders_submitted_total[1m]))",
          "legendFormat": "Orders/min"
        }
      ],
      "xAxis": {
        "mode": "time"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 8,
      "title": "Order Latency",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(trading_order_execution_latency_ms_bucket[5m])))",
          "legendFormat": "p95 Latency"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(trading_order_execution_latency_ms_bucket[5m])))",
          "legendFormat": "p50 Latency"
        }
      ],
      "xAxis": {
        "mode": "time"
      },
      "yAxes": [
        {
          "label": "Seconds",
          "unit": "s"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "id": 9,
      "title": "WebSocket Connection Status",
      "type": "stat",
      "targets": [
        {
          "expr": "trading_websocket_connected",
          "legendFormat": "Connected"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "Disconnected"
                },
                "1": {
                  "text": "Connected"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 10,
      "title": "Circuit Breaker Status",
      "type": "stat",
      "targets": [
        {
          "expr": "trading_circuit_breaker_open",
          "legendFormat": "Status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "Closed"
                },
                "1": {
                  "text": "Open"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 24
      }
    },
    {
      "id": 11,
      "title": "Daily Loss",
      "type": "stat",
      "targets": [
        {
          "expr": "clamp_min(-trading_daily_pnl, 0)",
          "legendFormat": "Loss (USD)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 24
      }
    },
    {
      "id": 12,
      "title": "Current Exposure",
      "type": "stat",
      "targets": [
        {
          "expr": "trading_total_exposure",
          "legendFormat": "Exposure (USD)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5000
              },
              {
                "color": "red",
                "value": 8000
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 24
      }
    }
  ]
}
