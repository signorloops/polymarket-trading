# Polymarket Trading System Configuration
# Copy this file to .env and fill in your values

# ============================================
# Network Configuration
# ============================================
# RPC URL for blockchain connection (use Helius or other provider)
# Example: https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
RPC_URL=

# WebSocket URL for real-time market data
WS_URL=wss://ws.polymarket.com

# Polymarket API key
POLYMARKET_API_KEY=

# Connection timeout in milliseconds
CONNECTION_TIMEOUT=30000

# Reconnect interval in milliseconds
RECONNECT_INTERVAL=5000

# Maximum reconnection attempts
MAX_RECONNECT_ATTEMPTS=10

# ============================================
# Wallet Configuration
# ============================================
# WARNING: Never commit your private key to version control!
# Use a secure key management solution in production
PRIVATE_KEY=

# Your wallet address
WALLET_ADDRESS=

# ============================================
# Algorithm Parameters
# ============================================
# Alpha-extraction: capture at least (1 - ALPHA) of available arbitrage
# Default: 0.9 (capture 90% of arbitrage)
ALPHA=0.9

# Initial epsilon for barrier function shrinkage
# Default: 0.1
INITIAL_EPSILON=0.1

# Convergence threshold for Frank-Wolfe
# Default: 1e-6
CONVERGENCE_THRESHOLD=1e-6

# Maximum iterations for Frank-Wolfe
# Default: 150
MAX_ITERATIONS=150

# Minimum profit threshold in USD
# Default: 0.05
MIN_PROFIT_THRESHOLD=0.05

# Barrier function parameter for LMSR gradient handling
# Default: 1.0
BARRIER_PARAMETER=1.0

# ============================================
# Trading Parameters
# ============================================
# Maximum position size as fraction of order book depth
# Default: 0.5 (50%)
MAX_POSITION_PCT=0.5

# Time window for trade validity in blocks (~1 hour)
# Default: 950
TIME_WINDOW_BLOCKS=950

# Slippage tolerance percentage
# Default: 0.02 (2%)
SLIPPAGE_TOLERANCE=0.02

# Maximum concurrent trades
# Default: 5
MAX_CONCURRENT_TRADES=5

# Minimum order book depth for trading in USD
# Default: 100
MIN_ORDER_BOOK_DEPTH=100

# ============================================
# Kelly Criterion Parameters
# ============================================
# Kelly fraction multiplier (conservative: 0.25, aggressive: 0.5)
# Default: 0.25
KELLY_FRACTION=0.25

# Minimum probability threshold for betting
# Default: 0.51
MIN_PROBABILITY=0.51

# Maximum bet size as fraction of capital
# Default: 0.1 (10%)
MAX_BET_FRACTION=0.1

# ============================================
# Risk Management
# ============================================
# Maximum daily loss in USD
# Default: 1000
MAX_DAILY_LOSS=1000

# Maximum total exposure in USD
# Default: 10000
MAX_EXPOSURE=10000

# Emergency stop threshold (unrealized loss)
# Default: 500
EMERGENCY_STOP_THRESHOLD=500

# Enable circuit breaker
# Default: true
CIRCUIT_BREAKER_ENABLED=true

# ============================================
# Logging Configuration
# ============================================
# Log level: debug, info, warn, error
# Default: info
LOG_LEVEL=info

# Enable silent mode (no console output)
# Default: false
SILENT=false

# ============================================
# Environment
# ============================================
# Node environment: development, test, production
NODE_ENV=development

# ============================================
# Alert Notifications (Task 16)
# ============================================
# Enable/disable alerts
# Default: true
ALERTS_ENABLED=true

# Minimum alert level to send (info, warning, critical)
# Default: info
ALERTS_MIN_LEVEL=info

# Deduplication window in minutes (prevents duplicate alerts)
# Default: 5
ALERTS_DEDUP_WINDOW_MINUTES=5

# --- Slack Integration ---
# Slack webhook URL (create at https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=

# Slack channel to post to (optional, overrides webhook default)
SLACK_CHANNEL=#alerts

# Slack bot username (optional)
SLACK_USERNAME=Polymarket Alerts

# Slack bot icon emoji (optional)
SLACK_ICON_EMOJI=:warning:

# --- Discord Integration ---
# Discord webhook URL (create in Server Settings -> Integrations)
DISCORD_WEBHOOK_URL=

# Discord webhook username (optional)
DISCORD_USERNAME=Polymarket Alerts

# --- Email Configuration ---
# SMTP server host
SMTP_HOST=

# SMTP server port (default: 587)
SMTP_PORT=587

# Use TLS (default: false for port 587, true for 465)
SMTP_SECURE=false

# SMTP authentication username
SMTP_USER=

# SMTP authentication password
SMTP_PASS=

# From email address for alerts
ALERT_EMAIL_FROM=

# Comma-separated list of recipient email addresses
ALERT_EMAIL_TO=

# --- PagerDuty Integration ---
# PagerDuty Events API v2 integration key
PAGERDUTY_INTEGRATION_KEY=

# --- Alert Routing Rules ---
# Comma-separated list of channels for each level
# Available channels: slack, discord, email, pagerduty
# Default: (empty for info)
ALERT_ROUTING_INFO=

# Default: slack,email
ALERT_ROUTING_WARNING=slack,email

# Default: slack,email,pagerduty
ALERT_ROUTING_CRITICAL=slack,email,pagerduty
